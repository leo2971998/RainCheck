# Server-only values. Never prefix credentials with VITE_.
# Supabase runtime connection. Keep the secret key on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local migration/setup connection (session pooler supports IPv4).
# Keep the raw password quoted; do not URL-encode it.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=''

NESSIE_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ID=
NESSIE_SAVINGS_ID=
VITE_DATA_MODE=sample
VITE_DEMO_DATE=2026-09-28

# Optional isolated backend test household (IDs from output/nessie-backend-v1/manifest.json).
NESSIE_TEST_CUSTOMER_ID=
NESSIE_TEST_CHECKING_ID=
NESSIE_TEST_SAVINGS_ID=
NESSIE_TEST_AS_OF=2026-09-28
# Loopback development access. Public demo review has a separate opt-in below.
RAINCHECK_AI_LOCAL=0
# Text-only chat. Both values stay on the server; never prefix with VITE_.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Optional public read-only chat on the production origin. Does not enable bank writes.
RAINCHECK_PUBLIC_CHAT=0
RAINCHECK_CHAT_ORIGIN=https://raincheck-planner.vercel.app
# Server-only random secret (32+ characters) for anonymous usage-limit fingerprints.
RAINCHECK_CHAT_RATE_SECRET=
# Opt-in shared demo purchases on this production origin. Uses the same Supabase
# local-demo records and Nessie household as local development; no bank writes.
RAINCHECK_SHARED_DEMO=0
RAINCHECK_DEMO_ORIGIN=https://raincheck-planner.vercel.app
# Read-only public AI explanations and budget optimization. Requires shared demo,
# the server credential below, and durable rate limits. Never applies a budget.
RAINCHECK_PUBLIC_REVIEW=0
# Server-only credential (never VITE_*). Use either the secret or an ignored key file.
ZEROCLAW_REVIEW_KEY=
ZEROCLAW_REVIEW_KEY_FILE=
