# Server-only values. Never prefix credentials with VITE_.
# Supabase runtime connection. Keep the secret key on the server only.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Local migration/setup connection (session pooler supports IPv4).
# Keep the raw password quoted; do not URL-encode it.
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=''

NESSIE_KEY=
NESSIE_CUSTOMER_ID=
NESSIE_CHECKING_ID=
NESSIE_SAVINGS_ID=
VITE_DATA_MODE=sample
VITE_DEMO_DATE=2026-09-28

# Optional isolated backend test household (IDs from output/nessie-backend-v1/manifest.json).
NESSIE_TEST_CUSTOMER_ID=
NESSIE_TEST_CHECKING_ID=
NESSIE_TEST_SAVINGS_ID=
NESSIE_TEST_AS_OF=2026-09-28
# Local prototype only. The public review endpoint stays disabled until user auth is added.
RAINCHECK_AI_LOCAL=0
# Server-only credential (never VITE_*). Use either the secret or an ignored key file.
ZEROCLAW_REVIEW_KEY=
ZEROCLAW_REVIEW_KEY_FILE=
